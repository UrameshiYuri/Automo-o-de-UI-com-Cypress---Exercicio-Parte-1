{
  "name": "yuri",
  "version": "1.0.0",
  "description": "fluxograma de criaçao de conta e carrinho com cypress",
  "license": "ISC",
  "author": "Yuri Mielli",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress open",
    "test:allure": "npx cypress run --env allure=true && npm run allure:generate",
    "allure:open": "npx allure serve",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "sorry:cypress": "CYPRESS_API_URL=\"http://localhost:1234/\" npx cy2 run --record --key EBAC --parallel --ci-build-id `date +%s`"
  },
  "dependencies": {
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.43.0",
    "cy2": "^4.0.9",
    "cypress": "^15.19.0",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "devDependencies": {}
}
